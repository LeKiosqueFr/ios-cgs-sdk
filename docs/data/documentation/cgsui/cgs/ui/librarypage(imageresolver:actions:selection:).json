eIdentifier","preciseIdentifier":"s:7SwiftUI7BindingV"},{"text":"<","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"CGS","kind":"typeIdentifier","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS","preciseIdentifier":"s:7CGSData3CGSO"},{"text":".","kind":"text"},{"text":"Data","kind":"typeIdentifier","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/Data","preciseIdentifier":"s:7CGSData3CGSO4DataO"},{"text":".","kind":"text"},{"text":"Issue","kind":"typeIdentifier","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/Data\/Issue","preciseIdentifier":"s:7CGSData3CGSO4DataO5IssueO"},{"text":".","kind":"text"},{"text":"Short","kind":"typeIdentifier","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/Data\/Issue\/Short","preciseIdentifier":"s:7CGSData3CGSO4DataO5IssueO5ShortV"},{"text":".","kind":"text"},{"text":"Identifier","kind":"typeIdentifier","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/Data\/Issue\/Short\/Identifier-swift.typealias","preciseIdentifier":"s:7CGSData3CGSO4DataO5IssueO5ShortV10Identifiera"},{"text":">>? = nil) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI4ViewP"},{"text":"\n","kind":"text"}],"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"Maps each cover’s remote URL to the local file holding it. Returning "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" "},{"type":"text","text":"renders the cell’s cover placeholder at full size rather than collapsing it."}],"type":"paragraph"}],"name":"imageResolver"},{"content":[{"inlineContent":[{"type":"text","text":"What the reader’s taps trigger."}],"type":"paragraph"}],"name":"actions"},{"content":[{"inlineContent":[{"type":"text","text":"The issues currently ticked. Non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" switches the page into selection mode."},{"type":"text","text":" "},{"type":"text","text":"Identifiers of issues the page is not showing are left untouched, so a set that outlives a"},{"type":"text","text":" "},{"type":"text","text":"reload keeps whatever it already held."}],"type":"paragraph"}],"name":"selection"}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Nothing to supply. The page reads the active profile’s finished downloads off the device and","type":"text"},{"text":" ","type":"text"},{"text":"names them from the metadata each one already carries, so it needs no list of candidates and no","type":"text"},{"text":" ","type":"text"},{"text":"network — it draws the same in a tunnel as on Wi-Fi. Anything still queued, downloading, paused","type":"text"},{"text":" ","type":"text"},{"text":"or failed is left out, and a download that completes while the page is open appears on its own.","type":"text"},{"text":" ","type":"text"},{"text":"The column count follows the width the page is offered, so the same call fits an iPhone and an","type":"text"},{"text":" ","type":"text"},{"text":"iPad in either orientation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Most recently downloaded first: a reader who has just taken an issue offline looks for it at","type":"text"},{"text":" ","type":"text"},{"text":"the top, whatever its release date says.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The page lays out in the host’s scroll context and owns no navigation bar, so place it inside","type":"text"},{"text":" ","type":"text"},{"text":"whatever chrome the app already has.","type":"text"}]},{"code":["CGS.UI.libraryPage(","    imageResolver: resolver,","    actions: .init(onSelectIssue: { issue in \/* open the reader *\/ })",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Selecting-several-issues","type":"heading","level":2,"text":"Selecting several issues"},{"type":"paragraph","inlineContent":[{"text":"Passing a ","type":"text"},{"type":"codeVoice","code":"selection"},{"text":" binding puts the page in selection mode: every cell draws a checkbox and","type":"text"},{"text":" ","type":"text"},{"text":"a tap adds or removes that issue instead of calling ","type":"text"},{"type":"codeVoice","code":"onSelectIssue"},{"text":". Pass ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" — the default —","type":"text"},{"text":" ","type":"text"},{"text":"to leave taps opening issues. An edit-mode toggle is therefore a binding the host swaps in and","type":"text"},{"text":" ","type":"text"},{"text":"out, with no separate flag to keep in step:","type":"text"}]},{"code":["@State private var isEditing = false","@State private var selected: Set<CGS.Data.Issue.Short.Identifier> = []","","CGS.UI.libraryPage(","    imageResolver: resolver,","    actions: .init(onSelectIssue: { issue in \/* open the reader *\/ }),","    selection: self.isEditing ? self.$selected : nil",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Acting on the selection — deleting the downloads, and the button that does it — belongs to the","type":"text"},{"text":" ","type":"text"},{"text":"host, which owns the navigation bar the page deliberately does not.","type":"text"}]}],"kind":"content"}],"sections":[],"references":{"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS","navigatorTitle":[{"kind":"identifier","text":"CGS"}],"type":"topic","url":"\/documentation\/cgsui\/cgs","role":"symbol","title":"CGS","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CGS"}]},"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS/Data/Issue":{"role":"symbol","title":"CGS.Data.Issue