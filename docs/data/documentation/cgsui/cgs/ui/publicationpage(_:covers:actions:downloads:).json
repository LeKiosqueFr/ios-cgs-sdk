fier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/PublicationPage\/Actions","text":"Actions","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"downloads","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7CGSData3CGSO","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS","text":"CGS","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI","text":"UI","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO14IssueDownloadsV","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/IssueDownloads","text":"IssueDownloads","kind":"typeIdentifier"},{"text":" = .hidden) -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"},{"text":"\n","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The issue the page opens on, directly or through its publication."}],"type":"paragraph"}],"name":"source"},{"content":[{"inlineContent":[{"type":"text","text":"Where the page finds each cover on disk."}],"type":"paragraph"}],"name":"covers"},{"content":[{"inlineContent":[{"type":"text","text":"What the reader’s taps trigger. Opening the featured issue is not among them —"},{"type":"text","text":" "},{"type":"text","text":"the page does that itself."}],"type":"paragraph"}],"name":"actions"},{"content":[{"inlineContent":[{"type":"text","text":"Whether the header offers an offline copy, and whether this page may remove"},{"type":"text","text":" "},{"type":"text","text":"one. Off by default: resolving a download record is work a host with no offline feature"},{"type":"text","text":" "},{"type":"text","text":"should not pay for."}],"type":"paragraph"}],"name":"downloads"}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Nothing to compose. From the one identifier in "},{"code":"source","type":"codeVoice"},{"type":"text","text":" the page resolves every list it shows"},{"type":"text","text":" "},{"type":"text","text":"— the featured issue, then that issue’s articles, that issue’s supplements and its"},{"type":"text","text":" "},{"type":"text","text":"publication’s archives — loads them itself, opens the reader on Read, zooming out of its own cover, and,"},{"type":"text","text":" "},{"type":"text","text":"when "},{"code":"downloads","type":"codeVoice"},{"type":"text","text":" says so, manages the issue’s offline copy. In a compact width the header and"},{"type":"text","text":" "},{"type":"text","text":"the lists stack and scroll as one; in a regular width (iPad, or a wide phone in landscape) the"},{"type":"text","text":" "},{"type":"text","text":"header holds a fixed left column while the contents scroll beside it."}],"type":"paragraph"},{"inlineContent":[{"text":"The featured issue gates the page: it carries the page’s identity and every list is keyed off","type":"text"},{"text":" ","type":"text"},{"text":"it, so if it cannot be loaded the page shows a retry rather than a headless list of articles. A","type":"text"},{"text":" ","type":"text"},{"text":"list that fails on its own keeps its retry inside its section, and a section whose list comes","type":"text"},{"text":" ","type":"text"},{"text":"back empty removes itself — which is how a publication with no supplement, or a first issue","type":"text"},{"text":" ","type":"text"},{"text":"with no archive, costs the page nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Tapping a supplement or an archive moves this page onto that issue, travelling back to its","type":"text"},{"text":" ","type":"text"},{"text":"cover on the way, instead of asking the host to push a second one: browsing a title is one","type":"text"},{"text":" ","type":"text"},{"text":"screen, not a stack as deep as the reader was curious.","type":"text"}],"type":"paragraph"},{"code":["CGS.UI.publicationPage(","    .publication(publicationId),","    covers: .init(issue: issueResolver, article: articleResolver),","    actions: .init(","        onSelectArticle: { article in \/* open the article *\/ },","        onSeeAllArticles: { issueId in \/* open that issue's full contents *\/ },","        onSeeAllArchives: { publicationId in \/* open that publication's archives *\/ }","    ),","    downloads: .managed",")"],"type":"codeListing","syntax":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI","doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS","doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"A single-publication page, whole: the featured issue’s cover, title, date and controls, then","type":"text"},{"text":" ","type":"text"},{"text":"the publication’s articles as a capped teaser, its supplements as a peeking carousel, and its","type":"text"},{"text":" ","type":"text"},{"text":"archives as a column grid.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cgsui\/cgs\/ui\/publicationpage(_:covers:actions:downloads:)"]}],"kind":"symbol","references":{"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS","navigatorTitle":[{"kind":"identifier","text":"CGS"}],"type":"topic","url":"\/documentation\/cgsui\/cgs","role":"symbol","title":"CGS","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CGS"}]},"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS/UI/publicationPage(_:covers:actions:downloads:)":{"role":"symbol","title":"publicationPage(_:covers:actions:downloads:)","identifier":"doc:\/\/co.cafeyn.C