r":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/SectionPage\/Actions","text":"Actions","preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO11SectionPageO7ActionsV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The skeleton to draw, as given by the backend."}]}],"name":"skeletonIdentifier"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The page layout. "},{"type":"codeVoice","code":".default"},{"type":"text","text":" fits most pages."}]}],"name":"configuration"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What the reader’s taps trigger."}]}],"name":"actions"}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"The page loads the skeleton when it first appears, for the signed-in profile. It asks for the","type":"text"},{"text":" ","type":"text"},{"text":"next page of blocks when its last section appears, and adds it below: the sections already on","type":"text"},{"text":" ","type":"text"},{"text":"screen keep their content and their scroll position. A block the SDK cannot draw is skipped.","type":"text"},{"text":" ","type":"text"},{"text":"Each block’s title shows the backend’s default text.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A section whose title leads to another page shows a chevron next to it, if ","type":"text"},{"code":"actions","type":"codeVoice"},{"text":" has an","type":"text"},{"text":" ","type":"text"},{"code":"onDestination","type":"codeVoice"},{"text":". A tap calls it with a ","type":"text"},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/Destination","isActive":true,"type":"reference"},{"text":". The SDK never navigates: push or","type":"text"},{"text":" ","type":"text"},{"text":"present that page yourself.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the first load fails, the page shows a message with a retry button. Without a session or a","type":"text"},{"text":" ","type":"text"},{"text":"profile it shows a message with no retry, since a retry cannot help.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"With ","type":"text"},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/SectionPage\/UIConfiguration\/isRefreshable","isActive":true,"type":"reference"},{"text":", a pull loads the skeleton again from","type":"text"},{"text":" ","type":"text"},{"text":"the network, then the sections it keeps. The page goes back to the first page of blocks.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Passing another identifier draws the other skeleton from the start.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS/UI/sectionPage(skeleton:configuration:actions:)":{"abstract":[{"type":"text","text":"Draws a page the backend describes block by block, with one self-driving section per block."}],"url":"\/documentation\/cgsui\/cgs\/ui\/sectionpage(skeleton:configuration:actions:)","title":"sectionPage(skeleton:configuration:actions:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sectionPage"},{"kind":"text","text":"("},{"kind":"externalParam","text":"skeleton"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CGS","preciseIdentifier":"s:7CGSData3CGSO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Data","preciseIdentifier":"s:7CGSData3CGSO4DataO"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Ske