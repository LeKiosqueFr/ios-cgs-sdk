{"relationshipsSections":[{"identifiers":["doc:\/\/co.cafeyn.CGSUI\/s8SendableP","doc:\/\/co.cafeyn.CGSUI\/7SwiftUI4ViewP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"variants":[{"paths":["\/documentation\/cgsui\/cgs\/ui\/textfield"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/TextField"},"metadata":{"symbolKind":"struct","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TextField"}],"modules":[{"name":"CGSUI"}],"extendedModule":"CGSUI","title":"CGS.UI.TextField","externalID":"s:7CGSData3CGSO5CGSUIE2UIO9TextFieldV","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TextField"}]},"hierarchy":{"paths":[["doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI","doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS","doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI"]]},"kind":"symbol","abstract":[{"type":"text","text":"A single-line text input with a label, a placeholder and a feedback message."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"identifiers":["doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/TextField\/Label","doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/TextField\/Message","doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/TextField\/UIConfiguration"],"anchor":"Structures","title":"Structures","generated":true},{"identifiers":["doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/TextField\/init(_:text:prompt:message:leadingIcon:configuration:)","doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/TextField\/init(_:text:prompt:message:leadingIcon:configuration:trailing:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/TextField\/body"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"identifiers":["doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/TextField\/View-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextField","kind":"identifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The field draws its label above the input and an optional ","type":"text"},{"type":"reference","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/TextField\/Message","isActive":true},{"text":" below it. Its border","type":"text"},{"text":" ","type":"text"},{"text":"follows what the user does: it highlights while the field is edited, darkens once it holds","type":"text"},{"text":" ","type":"text"},{"text":"text, and turns red or green when the message is an error or a success.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@State private var email = \"\"","","CGS.UI.TextField(\"Email\", text: self.$email, prompt: \"name@example.com\")","    .keyboardType(.emailAddress)","    .textContentType(.username)","","CGS.UI.TextField(","    .init(\"Email\", description: \"The address you signed up with\", isMandatory: true),","    text: self.$email,","    message: isValid ? nil : .error(\"Enter a valid email address.\")",")"]},{"type":"paragraph","inlineContent":[{"text":"Keyboard, content type, submit and focus modifiers apply to the field the same way they apply to a","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI ","type":"text"},{"type":"codeVoice","code":"TextField"},{"text":": ","type":"text"},{"type":"codeVoice","code":".focused(_:equals:)"},{"text":" with ","type":"text"},{"type":"codeVoice","code":".onSubmit"},{"text":" moves the keyboard to the next field.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".disabled(true)"},{"text":" applied by any ancestor greys the whole field out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The label, placeholder and message are shown as is, never looked up in a string catalog: pass","type":"text"},{"text":" ","type":"text"},{"text":"text you already localized. A ","type":"text"},{"type":"codeVoice","code":"String"},{"text":" value becomes a label with ","type":"text"},{"type":"codeVoice","code":".init(_:)"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The trailing slot holds an optional view, such as a clear button, in a 44 × 44 pt tap target:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["CGS.UI.TextField(\"Search\", text: self.$query) {","    SwiftUI.Button { self.query = \"\" } label: { Icon.Navigation.close.size(.small) }","        .accessibilityLabel(\"Clear\")","}"]},{"type":"paragraph","inlineContent":[{"text":"VoiceOver reads the label, the message named by its kind, such as “Error”, then the text. The","type":"text"},{"text":" ","type":"text"},{"text":"message is part of the label, so it is read even with hints turned off, and it says the kind","type":"text"},{"text":" ","type":"text"},{"text":"that only the colour and the icon show on screen. The description is read as the hint.","type":"text"}]}]}],"references":{"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS/UI/TextField/View-Implementations":{"type":"topic","title":"View Implementations","role":"collectionGroup","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/TextField\/View-Implementations","kind":"article","abstract":[],"url":"\/documentation\/cgsui\/cgs\/ui\/textfield\/view-implementations"},"doc://co.cafeyn.CGSUI/s8SendableP":{"type":"unresolv