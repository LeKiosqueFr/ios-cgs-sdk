":"typeIdentifier","preciseIdentifier":"s:7CGSData3CGSO","text":"CGS"},{"kind":"text","text":"."},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI","kind":"typeIdentifier","preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO","text":"UI"},{"kind":"text","text":"."},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/PublicationPage","kind":"typeIdentifier","preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO15PublicationPageO","text":"PublicationPage"},{"kind":"text","text":"."},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/PublicationPage\/Actions","kind":"typeIdentifier","preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO15PublicationPageO7ActionsV","text":"Actions"},{"kind":"text","text":") -> "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier","text":"View"},{"kind":"text","text":"\n"}]}],"kind":"declarations"},{"parameters":[{"name":"source","content":[{"inlineContent":[{"text":"The issue the page opens on, directly or through its publication.","type":"text"}],"type":"paragraph"}]},{"name":"actions","content":[{"inlineContent":[{"text":"What the reader’s taps trigger. Opening the featured issue is not among them —","type":"text"},{"text":" ","type":"text"},{"text":"the page does that itself.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Nothing to compose. From the one identifier in ","type":"text"},{"code":"source","type":"codeVoice"},{"text":" the page resolves every list it shows","type":"text"},{"text":" ","type":"text"},{"text":"— the featured issue, then that issue’s articles, that issue’s supplements and its","type":"text"},{"text":" ","type":"text"},{"text":"publication’s archives — loads them itself, opens the reader on Read, zooming out of its own cover, and","type":"text"},{"text":" ","type":"text"},{"text":"manages the issue’s offline copy. In a compact width the header and the lists stack and scroll","type":"text"},{"text":" ","type":"text"},{"text":"as one; in a regular width (iPad, or a wide phone in landscape) the header holds a fixed left","type":"text"},{"text":" ","type":"text"},{"text":"column while the contents scroll beside it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The featured issue gates the page: it carries the page’s identity and every list is keyed off","type":"text"},{"text":" ","type":"text"},{"text":"it, so if it cannot be loaded the page shows a retry rather than a headless list of articles. A","type":"text"},{"text":" ","type":"text"},{"text":"list that fails on its own keeps its retry inside its section, and a section whose list comes","type":"text"},{"text":" ","type":"text"},{"text":"back empty removes itself — which is how a publication with no supplement, or a first issue","type":"text"},{"text":" ","type":"text"},{"text":"with no archive, costs the page nothing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Tapping a supplement or an archive moves this page onto that issue, travelling back to its","type":"text"},{"text":" ","type":"text"},{"text":"cover on the way, instead of asking the host to push a second one: browsing a title is one","type":"text"},{"text":" ","type":"text"},{"text":"screen, not a stack as deep as the reader was curious.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["CGS.UI.publicationPage(","    .publication(publicationId),","    actions: .init(","        onSelectArticle: { article in \/* open the article *\/ },","        onSeeAllArticles: { issueId in \/* open that issue's full contents *\/ },","        onSeeAllArchives: { publicationId in \/* open that publication's archives *\/ }","    )",")"],"type":"codeListing"},{"inlineContent":[{"text":"Covers need nothing from you: the SDK owns where every image it draws lives, and reads one out","type":"text"},{"text":" ","type":"text"},{"text":"of the issue’s offline copy when that issue is downloaded.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/publicationPage(_:actions:)"},"references":{"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS/UI":{"url":"\/documentation\/cgsui\/cgs\/ui","type":"topic","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI","navigatorTitle":[{"text":"UI","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"UI","kind":"identifier"}],"abstract":[],"role":"symbol","title":"CGS.UI"},"doc://co.cafeyn.CGSUI/documentation/CGSUI":{"title":"CGSUI","kind":"symbol","role":"collection","url":"\/documentation\/cgsui","abstract":[],"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI","type":"topic"},"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS/UI/publicationPage(_:actions:)":{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/publicationPage(_:actions:)","kind":"symbol","role":"symbol","url":"\/documentation\/cgsui\/cgs\/ui\/publicationpage(_:actions:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"publicationPage","kind":"identifier"},{"text":"(","kind":"text"},{"text":"CGS","kind":"typeIdentifier","preciseIdentifier":"s:7CGSData3CGSO"},{"text":".","kind":"text"},{"text":"UI","kind":"typeIdentifier","preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO"},{"text":".","kind":"text"},{"text":"PublicationPage","kind":"typeIdentifier","preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO15PublicationPageO"},{"text":".","kind":"text"},{"text":"Source","kind":"typeIdentifier","preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO15PublicationPageO6SourceO"},{"text":", ","kind":"text"},{"text":"actions","kind":"externalParam"},{"text":": ","kind":"text"},