c:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI"]]},"kind":"symbol","abstract":[{"text":"A single-publication page, whole: the featured issue’s cover, title, date and controls, then","type":"text"},{"text":" ","type":"text"},{"text":"the publication’s articles as a capped teaser, its supplements on one horizontal line, and","type":"text"},{"text":" ","type":"text"},{"text":"its archives in adaptive columns.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"publicationPage","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"source","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS","preciseIdentifier":"s:7CGSData3CGSO","text":"CGS","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI","preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO","text":"UI","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/PublicationPage","preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO15PublicationPageO","text":"PublicationPage","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/PublicationPage\/Source","preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO15PublicationPageO6SourceO","text":"Source","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"actions","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS","preciseIdentifier":"s:7CGSData3CGSO","text":"CGS","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI","preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO","text":"UI","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/PublicationPage","preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO15PublicationPageO","text":"PublicationPage","kind":"typeIdentifier"},{"text":".","kind":"text"},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/PublicationPage\/Actions","preciseIdentifier":"s:7CGSData3CGSO5CGSUIE2UIO15PublicationPageO7ActionsV","text":"Actions","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI4ViewP","text":"View","kind":"typeIdentifier"},{"text":"\n","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The issue the page opens on, directly or through its publication."}],"type":"paragraph"}],"name":"source"},{"content":[{"inlineContent":[{"type":"text","text":"What the reader’s taps trigger. Opening the featured issue is not among them —"},{"type":"text","text":" "},{"type":"text","text":"the page does that itself."}],"type":"paragraph"}],"name":"actions"}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Nothing to compose. From the one identifier in "},{"type":"codeVoice","code":"source"},{"type":"text","text":" the page resolves every list it shows"},{"type":"text","text":" "},{"type":"text","text":"— the featured issue, then that issue’s articles, that issue’s supplements and its"},{"type":"text","text":" "},{"type":"text","text":"publication’s archives — loads them itself, opens the reader on Read, zooming out of its own cover, and"},{"type":"text","text":" "},{"type":"text","text":"manages the issue’s offline copy. In a compact width the header and the lists stack and scroll"},{"type":"text","text":" "},{"type":"text","text":"as one; in a regular width (iPad, or a wide phone in landscape) the header holds a fixed left"},{"type":"text","text":" "},{"type":"text","text":"column while the contents scroll beside it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The featured issue gates the page: it carries the page’s identity and every list is keyed off"},{"type":"text","text":" "},{"type":"text","text":"it, so if it cannot be loaded the page shows a retry rather than a headless list of articles. A"},{"type":"text","text":" "},{"type":"text","text":"list that fails on its own keeps its retry inside its section, and a section whose list comes"},{"type":"text","text":" "},{"type":"text","text":"back empty removes itself — which is how a publication with no supplement, or a first issue"},{"type":"text","text":" "},{"type":"text","text":"with no archive, costs the page nothing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Tapping a supplement or an archive moves this page onto that issue, travelling back to its"},{"type":"text","text":" "},{"type":"text","text":"cover on the way, instead of asking the host to push a second one: browsing a title is one"},{"type":"text","text":" "},{"type":"text","text":"screen, not a stack as deep as the reader was curious."}],"type":"paragraph"},{"code":["CGS.UI.publicationPage(","    .publication(publicationId),","    actions: .init(","        onSelectArticle: { article in \/* open the article *\/ },","        onSeeAllArticles: { issueId in \/* open that issue's full contents *\/ },","        onSeeAllArchives: { publicationId in \/* open that publication's archives *\/ }","    )",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Covers need nothing from you: the SDK owns where every image it draws lives, and reads one out"},{"type":"text","text":" "},{"type":"text","text":"of the issue’s offline copy when that issue is downloaded."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cgsui\/cgs\/ui\/publicationpage(_:actions:)"]}],"references":{"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS":{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS","role":"symbol","navigatorTitle":[{"text":"CGS","kind":"identifier"}],"type":"topic","kind":"symbol","abstract":[],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CGS","kind":"identifier"}],"title":"CGS","url":"\/documentation\/cgsui\/cgs"},"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS/UI/PublicationPage/Actions":{"type":"topic","title":"CGS.UI.PublicationPage.Actions","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Actions"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Actions"}],"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/PublicationPage\/Actions","kind":"symbol","abstract":[{"type":"text","text":"What the reader’s taps on a publication page trigger."}],"url":"\/documentation\/cgsui\/cgs\/ui\/publicationpage\/actions"},"doc://co.cafeyn.CGSUI/documentation/CGSUI":{"url":"\/documentation\/cgsui","kind":"symbol","type":"topic","abstract":[],"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI","title":"CGSUI","role":"collection"},"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS/UI":{"navigatorTitle":[{"text":"UI","kind":"identifier"}],"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI","type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UI","kind":"identifier"}],"abstract":[],"url":"\/documentation\/cgsui\/cgs\/ui","title":"CGS.UI","role":"symbol"},"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS/UI/PublicationPage":{"url":"\/docu