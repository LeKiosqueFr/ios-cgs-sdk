 the page the reader left, or set it to open a given"},{"type":"text","text":" "},{"type":"text","text":"page. It is keyed on the page "},{"type":"codeVoice","code":"id"},{"type":"text","text":", so it survives a reordering of "},{"type":"codeVoice","code":"pages"},{"type":"text","text":". When it is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"text","text":"names a page that is no longer in "},{"type":"codeVoice","code":"pages"},{"type":"text","text":", the pager shows the first page and writes its "},{"type":"codeVoice","code":"id"},{"type":"text","text":" "},{"type":"text","text":"back to "},{"type":"codeVoice","code":"selection"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a "},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/Data\/Media","isActive":true,"type":"reference"},{"type":"text","text":", pass its "},{"type":"codeVoice","code":"pages"},{"type":"text","text":" and draw each one with"},{"type":"text","text":" "},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/mediaPage(_:configuration:actions:)","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"codeListing","code":["@State private var selectedPage: Page.ID?","","var body: some View {","    CGS.UI.pager(pages: pages, selection: $selectedPage, title: \\.title) { page in","        PageView(page: page)","    }","    .navigationBarTitleDisplayMode(.inline)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI may build the page next to the visible one before the reader reaches it, so a page that"},{"type":"text","text":" "},{"type":"text","text":"loads in "},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":" can start loading early."}]},{"type":"aside","style":"warning","content":[{"inlineContent":[{"type":"text","text":"A large navigation title above the pager does not collapse when a page 