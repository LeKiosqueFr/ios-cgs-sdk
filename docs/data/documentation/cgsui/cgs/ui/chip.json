":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Chip"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/Chip","type":"reference","isActive":true},{"type":"text","text":" for a compact secondary action — filtering a list, entering a category, opening"},{"type":"text","text":" "},{"type":"text","text":"a “see all” destination. It is the interactive counterpart of "},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/Tag","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Content and configuration","level":2,"type":"heading","anchor":"Content-and-configuration"},{"inlineContent":[{"type":"text","text":"Content (label + an optional icon on one side) is passed as a "},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/Chip\/UIState","type":"reference","isActive":true},{"type":"text","text":" value. Visual"},{"type":"text","text":" "},{"type":"text","text":"styling comes from a "},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/Chip\/UIConfiguration","type":"reference","isActive":true},{"type":"text","text":" built with "},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/Chip\/UIConfiguration\/assistive(size:)","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["CGS.UI.Chip(","    state: .init(label: \"Sports\", icon: .leading(Icon.Operations.library)),","    configuration: .assistive(size: .small),","    action: { openCategory(.sports) }",")","","CGS.UI.Chip(","    state: .init(label: \"See all\", icon: .trailing(Icon.Navigation.chevronRight)),","    configuration: .assistive(size: .medium),","    action: { showEverything() }",")"],"type":"codeListing","syntax":"swift"},{"text":"Disabled","level":2,"type":"heading","anchor":"Disabled"},{"inlineContent":[{"type":"text","text":"Apply SwiftUI’s "},{"code":".disabled(true)","type":"codeVoice"},{"type":"text","text":" on the chip or any ancestor. The chip swaps to its disabled"},{"type":"text","text":" "},{"type":"text","text":"color tokens and stops firing "},{"code":"action","type":"codeVoice"},{"type":"text","text":". There is no chip-specific "},{"code":"enabled","type":"codeVoice"},{"type":"text","text":" flag — the"},{"type":"text","text":" "},{"type":"text","text":"standard SwiftUI environment is the single source of truth."}],"type":"paragraph"},{"text":"Accessibility","level":2,"type":"heading","anchor":"Accessibility"},{"inlineContent":[{"type":"text","text":"VoiceOver announces the chip as a button reading "},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/Chip\/UIState\/label","type":"reference","isActive":true},{"type":"text","text":". Pass"},{"type":"text","text":" "},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/Chip\/UIState\/accessibilityIdentifier","type":"reference","isActive":true},{"type":"text","text":" to make a specific chip reachable from a UI test — the"},{"type":"text","text":" "},{"type":"text","text":"SDK cannot derive a stable one, since several chips usually share a screen and their labels"},{"type":"text","text":" "},{"type":"text","text":"are localized."}],"type":"paragraph"},{"text":"Layout","level":2,"type":"heading","anchor":"Layout"},{"inlineContent":[{"type":"text","text":"The pill is drawn 24 pt ("},{"code":".small","type":"codeVoice"},{"type":"text","text":") or 32 pt ("},{"code":".medium","type":"codeVoice"},{"type":"text","text":") tall, but the chip reserves"},{"type":"text","text":" "},{"type":"text","text":"44 pt of height so the touch target meets the platform minimum: expect it to take more"},{"type":"text","text":" "},{"type":"text","text":"vertical space in a stack than the pill suggests. Width is capped at"},{"type":"text","text":" "},{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/Chip\/UIConfiguration\/maxWidth","type":"reference","isActive":true},{"type":"text","text":"; a longer label ellipsizes at the tail."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/cgsui\/cgs\/ui\/chip"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"extendedModule":"CGSUI","externalID":"s:7CGSData3CGSO5CGSUIE2UIO4ChipV","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Chip","kind":"identifier"}],"navigatorTitle":[{"text":"Chip","kind":"identifier"}],"modules":[{"name":"CGSUI"}],"role":"symbol","roleHeading":"Structure","title":"CGS.UI.Chip","symbolKind":"struct"},"abstract":[{"text":"A tappable pill that fires an action.","type":"text"}],"references":{"doc://co.cafeyn.CGSUI/s8SendableP":{"identifier":"doc:\/\/co.cafeyn.CGSUI\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS/UI/Chip/body":{"title":"body","abstract":[],"type":"topic","url":"\/documentation\/cgsui\/cgs\/ui\/chip\/body","role":"symbol","identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/Chip\/body","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"body","kind":"identifier"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","preciseIdentifier":"s:7SwiftUI4ViewP","kind":"typeIdentifier"}]},"doc://co.cafeyn.CGSUI/documentation/CGSUI/CGS/UI/Chip/Icon":{"identifier":"doc:\/\/co.cafeyn.CGSUI\/documentation\/CGSUI\/CGS\/UI\/Chip\/Icon","url":"\/documentation\/cgsui\/cgs\/ui\/chip\/icon","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Icon"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"