"type":"heading","anchor":"overview"},{"inlineContent":[{"text":"A provider built with one is loaded from the start: a list bound to it draws its cells on the","type":"text"},{"text":" ","type":"text"},{"text":"first frame, with no placeholder and no request for a page the caller already has. ","type":"text"},{"type":"codeVoice","code":"load()"},{"text":" ","type":"text"},{"text":"still refreshes over it, and ","type":"text"},{"type":"codeVoice","code":"loadMore()"},{"text":" continues from the cursor supplied here.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The page is used once, by the first provider built — for the profile active when the factory is","type":"text"},{"text":" ","type":"text"},{"text":"called, or for the first profile to resolve when none is active yet. Every rebuild after that","type":"text"},{"text":" ","type":"text"},{"text":"loads from the network instead, so content gathered for one reader is never shown to the next.","type":"text"},{"text":" ","type":"text"},{"text":"Until that first provider exists the page stands in for it: the content is already readable, and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"loadMore()"},{"text":" does nothing until a profile resolves.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let page = CGS.Data.FirstPage(items: publicationsIAlreadyHave, nextPageToken: theirCursor)","let publications = CGS.Data.Content.publications(with: identifiers, firstPage: page)","\/\/ publications.state is already loaded: no placeholder, no request"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"items"},{"type":"text","text":" and "},{"type":"codeVoice","code":"nextPageToken"},{"type":"text","text":" come from the same paginated response, gathered for"},{"type":"text","text":" "},{"type":"text","text":"the profile that will be reading them. Neither is checked: another response’s cursor pages onto"},{"type":"text","text":" "},{"type":"text","text":"unrelated content, and another reader’s content is shown as this one’s."}]}],"style":"note","name":"Precondition","type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/cgsdata\/cgs\/data\/firstpage"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data\/FirstPage"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://co.cafeyn.CGSData/documentation/CGSData/CGS/Data/FirstPage":{"title":"CGS.Data.FirstPage","navigatorTitle":[{"text":"FirstPage","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FirstPage","kind":"identifier"}],"abstract":[{"text":"A first page of content the caller already holds, handed to a paginated provider when it is","type":"text"},{"text":" ","type":"text"},{"text":"built.","type":"text"}],"type":"topic","identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data\/FirstPage","role":"symbol","kind":"symbol","url":"\/documentation\/cgsdata\/cgs\/data\/firstpage"},"doc://co.cafeyn.CGSData/documentation/CGSData":{"url":"\/documentation\/cgsdata","kind":"symbol","type":"topic","identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData","title":"CGSData","role":"collection","abstract":[]},"doc://co.cafeyn.CGSData/documentation/CGSData/CGS/Data":{"url":"\/documentation\/cgsdata\/cgs\/data","kind":"symbol","type":"topic","identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data","title":"CGS.Data","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Data"}],"abstract":[{"text":"Namespace for the SDK’s data layer public API (V1+).","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Data"}]},"doc://co.cafeyn.CGSData/s8SendableP":{"identifier":"doc:\/\/co.cafeyn.CGSData\/s8SendableP","type":"unresolvable","title":"S