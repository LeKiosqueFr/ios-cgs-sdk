{"variants":[{"paths":["\/documentation\/cgsdata\/cgs\/data\/firstpage"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData","doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS","doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data"]]},"identifier":{"url":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data\/FirstPage","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FirstPage"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Item"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Item"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A provider built with one is loaded from the start: a list bound to it draws its cells on the"},{"type":"text","text":" "},{"type":"text","text":"first frame, with no placeholder and no request for a page the caller already has. "},{"code":"load()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"still refreshes over it, and "},{"code":"loadMore()","type":"codeVoice"},{"type":"text","text":" continues from the cursor supplied here."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The page is used once, by the first provider built — for the profile active when the factory is"},{"type":"text","text":" "},{"type":"text","text":"called, or for the first profile to resolve when none is active yet. Every rebuild after that"},{"text":" ","type":"text"},{"text":"loads from the network instead, so content gathered for one reader is never shown to the next.","type":"text"},{"text":" ","type":"text"},{"text":"Until that first provider exists the page stands in for it: the content is already readable, and","type":"text"},{"text":" ","type":"text"},{"code":"loadMore()","type":"codeVoice"},{"text":" does nothing until a profile resolves.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let page = CGS.Data.FirstPage(items: publicationsIAlreadyHave, nextPageToken: theirCursor)","let publications = CGS.Data.Content.publications(with: identifiers, firstPage: page)","\/\/ publications.state is already loaded: no placeholder, no request"],"syntax":"swift"},{"style":"note","type":"aside","name":"Precondition","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"items"},{"type":"text","text":" and "},{"type":"codeVoice","code":"nextPageToken"},{"type":"text","text":" come from the same paginated response, gathered for"},{"type":"text","text":" "},{"type":"text","text":"the profile that will be reading them. Neither is checked: another response’s cursor pages onto"},{"type":"text","text":" "},{"type":"text","text":"unrelated content, and another reader’s content is shown as this one’s."}],"type":"paragraph"}]}]}],"abstract":[{"type":"text","text":"A first page of content the caller already holds, handed to a paginated provider when it is"},{"text":" ","type":"text"},{"text":"built.","type":"text"}],"sections":[],"metadata":{"externalID":"s:7CGSData3CGSO4DataO9FirstPageV","title":"CGS.Data.FirstPage","modules":[{"name":"CGSData"}],"extendedModule":"CGSData","symbolKind":"struct","navigatorTitle":[{"text":"FirstPage","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"FirstPage","kind":"identifier"}],"roleHeading":"Structure","role":"symbol"},"kind":"symbol","topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/co.cafeyn.CGSData\/d