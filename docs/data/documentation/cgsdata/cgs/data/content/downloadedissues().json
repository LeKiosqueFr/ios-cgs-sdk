{"hierarchy":{"paths":[["doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData","doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS","doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data","doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data\/Content"]]},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"downloadedIssues","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Issues","kind":"typeIdentifier","identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data\/Content\/Issues","preciseIdentifier":"s:7CGSData3CGSO4DataO7ContentO6Issuesa"}],"platforms":["iOS","iPadOS","Mac Catalyst"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads the device, never the network: every issue it lists is on disk by definition, so a"},{"type":"text","text":" "},{"type":"text","text":"library built on it opens in a tunnel. The metadata comes from the file each download folder"},{"type":"text","text":" "},{"type":"text","text":"already carries — written when the package was resolved, so the reader could draw its header"},{"type":"text","text":" "},{"type":"text","text":"offline — which is why this takes no identifiers and fetches nothing."}]},{"inlineContent":[{"text":"Scoped to the profile that owns the download, not to the account. Bytes are shared between","type":"text"},{"text":" ","type":"text"},{"text":"profiles that downloaded the same issue, but ownership is recorded per profile, and this","type":"text"},{"text":" ","type":"text"},{"text":"follows the active one: switching profile rebuilds the provider and the list with it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It also reloads itself. A download finishing or being deleted changes what the library holds"},{"type":"text","text":" "},{"type":"text","text":"without anyone calling "},{"type":"codeVoice","code":"load()"},{"type":"text","text":", so those two are watched here rather than left to the host —"},{"type":"text","text":" "},{"type":"text","text":"which is what lets a page bind to this and be done."}],"type":"paragraph"},{"inlineContent":[{"text":"A download whose metadata file is missing is left out. The file is written best-effort, and","type":"text"},{"text":" ","type":"text"},{"text":"nothing else on disk names the issue, so a row the page could not label is a row it cannot","type":"text"},{"text":" ","type":"text"},{"text":"draw. Downloading the issue again writes it.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data\/Content\/downloadedIssues()"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","variants":[{"paths":["\/documentation\/cgsdata\/cgs\/data\/content\/downloadedissues()"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"method","title":"downloadedIssues()","role":"symbol","modules":[{"name":"CGSData"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"downloadedIssues","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Issues","kind":"typeIdentifier","preciseIdentifier":"s:7CGSData3CGSO4DataO7ContentO6Issuesa"}],"externalID":"s:7CGSData3CGSO4DataO7ContentO16downloadedIssuesAG19PaginatedDependencyCy___AE5IssueO5ShortVGyFZ","extendedModule":"CGSData","roleHeading":"Type Method"},"abstract":[{"type":"text","text":"Returns a provider for the issues the active profile has finished downloading, most recently"},{"type":"text","text":" "},{"type":"text","text":"downloaded first."}],"references":{"doc://co.cafeyn.CGSData/documentation/CGSData/CGS/Data":{"title":"CGS.Data","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Data"}],"identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Namespace for the SDK’s data layer public API (V1+)."}],"url":"\/documentation\/cgsdata\/cgs\/data","role":"symbol","navigatorTitle":[{"text":"Data","kind":"identifier"}]},"doc://co.cafeyn.CGSData/documentation/CGSData/CGS/Data/Content/Issues":{"title":"CGS.Data.Content.Issues","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issues"}],"identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data\/Content\/Issues","type":"topic","kind":"symbol","abstract":[{"text":"Paginated archive of issues for a set of publications, most recent first.","type":"text"}],"url":"\/documentation\/cgsdata\/cgs\/data\/content\/issues","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Issues"}]},"doc://co.cafeyn.CGSData/documentation/CGSData/CGS/Data/Content":{"title":"CGS.Data.Content","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"identifier"}],"url":"\/documentation\/cgsdata\/cgs\/data\/content","kind":"symbol","navigatorTitle":[{"text":"Content","kind":"identifier"}],"abstract":[{"type":"text","text":"Namespace for the SDK’s content capability: publications, issues, articles, media and videos."}],"identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data\/Content","type":"topic","role":"symbol"},"doc://co.cafeyn.CGSData/documentation/CGSData/CGS":{"title":"CGS","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"CGS","kind":"identifier"}],"url":"\/documentation\/cgsdata\/cgs","kind":"symbol","navigatorTitle":[{"text":"CGS","kind":"identifier"}],"abstract":[{"text":"The SDK’s root namespace: every public type lives under it.","type":"text"}],"type":"topic","identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS","role":"symbol"},"doc://co.cafeyn.CGSData/documentation/CGSData":{"title":"CGSData","url":"\/documentation\/cgsdata","kind":"symbol","abstract":[],"type":"topic","identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData","role":"collection"},"doc://co.cafeyn.CGSData/documentation/CGSData/CGS/Data/Content/downloadedIssues()":{"identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data\/Content\/downloadedIssues()","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"downloadedIssues","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Issues","preciseIdentifier":"s:7CGSData3CGSO4DataO7ContentO6Issuesa","kind":"typeIdentifier"}],"url":"\/documentation\/cgsdata\/cgs\/data\/content\/downloadedissues()","abstract":[{"type":"text","text":"Returns a provider for the issues the active profile has finished downloading, most recently"},{"type":"text","text":" "},{"type":"text","text":"downloaded first."}],"type":"topic","kind":"symbol","role":"symbol","title":"downloadedIssues()"}}}