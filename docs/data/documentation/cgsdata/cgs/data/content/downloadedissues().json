{"variants":[{"paths":["\/documentation\/cgsdata\/cgs\/data\/content\/downloadedissues()"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"symbol","modules":[{"name":"CGSData"}],"extendedModule":"CGSData","externalID":"s:7CGSData3CGSO4DataO7ContentO16downloadedIssuesAG19PaginatedDependencyCy___AE5IssueO5ShortVGyFZ","symbolKind":"method","roleHeading":"Type Method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"downloadedIssues"},{"kind":"text","text":"() -> "},{"text":"Issues","kind":"typeIdentifier","preciseIdentifier":"s:7CGSData3CGSO4DataO7ContentO6Issuesa"}],"title":"downloadedIssues()"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data\/Content\/downloadedIssues()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["iOS","iPadOS","Mac Catalyst"],"tokens":[{"kind":"attribute","text":"@"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"downloadedIssues"},{"text":"() -> ","kind":"text"},{"identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data\/Content\/Issues","text":"Issues","kind":"typeIdentifier","preciseIdentifier":"s:7CGSData3CGSO4DataO7ContentO6Issuesa"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Reads the device, never the network: every issue it lists is on disk by definition, so a","type":"text"},{"text":" ","type":"text"},{"text":"library built on it opens in a tunnel. The metadata comes from the file each download folder","type":"text"},{"text":" ","type":"text"},{"text":"already carries — written when the package was resolved, so the reader could draw its header","type":"text"},{"text":" ","type":"text"},{"text":"offline — which is why this takes no identifiers and fetches nothing.","type":"text"}]},{"inlineContent":[{"text":"Scoped to the profile that owns the download, not to the account. Bytes are shared between","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"profiles that downloaded the same issue, but ownership is recorded per profile, and this"},{"text":" ","type":"text"},{"type":"text","text":"follows the active one: switching profile rebuilds the provider and the list with it."}],"type":"paragraph"},{"inlineContent":[{"text":"It also reloads itself. A download finishing or being deleted changes what the library holds","type":"text"},{"text":" ","type":"text"},{"text":"without anyone calling ","type":"text"},{"code":"load()","type":"codeVoice"},{"text":", so those two are watched here rather than left to the host —","type":"text"},{"text":" ","type":"text"},{"text":"which is what lets a page bind to this and be done.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A download whose metadata file is missing is left out. The file is written best-effort, and"},{"type":"text","text":" "},{"type":"text","text":"nothing else on disk names the issue, so a row the page could not label is a row it cannot"},{"type":"text","text":" "},{"type":"text","text":"draw. Downloading the issue again writes it."}],"type":"paragraph"}]}],"abstract":[{"text":"Returns a provider for the issues the active profile has finished downloading, most recently","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"downloaded first."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData","doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS","doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data","doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data\/Content"]]},"references":{"doc://co.cafeyn.CGSData/documentation/CGSData/CGS":{"title":"CGS","navigatorTitle":[{"kind":"identifier","text":"CGS"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CGS"}],"abstract":[{"text":"The SDK’s root namespace: every public type lives under it.","type":"text"}],"type":"topic","identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS","role":"symbol","kind":"symbol","url":"\/documentation\/cgsdata\/cgs"},"doc://co.cafeyn.CGSData/documentation/CGSData/CGS/Data":{"url":"\/documentation\/cgsdata\/cgs\/data","kind":"symbol","type":"topic","identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data","title":"CGS.Data","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Data"}],"abstract":[{"text":"Namespace for the SDK’s data layer public API (V1+).","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Data"}]},"doc://co.cafeyn.CGSData/documentation/CGSData/CGS/Data/Content":{"title":"CGS.Data.Content","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Content"}],"navigatorTitle":[{"text":"Content","kind":"identifier"}],"type":"topic","url":"\/documentation\/cgsdata\/cgs\/data\/content","identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/Data\/Content","abstract":[{"text":"Namespace for the SDK’s content capability: publications, issues, articles, media and videos.","type":"text"}],"kind":"symbol","role":"symbol"},"doc://co.cafeyn.CGSData/documentation/CGSData/CGS/Data/Content/Issues":{"title":"CGS.Data.Content.Issues","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Issues"}],"navigatorTitle":[{"kind":"identifier","text":"Issues"}],"type":"topic","identifier":"doc:\/\/co.cafeyn.CGSData\/documentation\/CGSData\/CGS\/D